# Cofoundy — Cal.com Web App + API v2 combined
#
# This builds on top of calcom/cal.com:latest (web app already built)
# and adds the NestJS API v2 server that must run on localhost:5555
# because that URL is baked into the web app's Next.js rewrites.
#
# Architecture: Two processes in one container (web:3000 + api:5555)
# Cal.com's own Docker Compose design expects exactly this setup.

# =============================================================================
# Stage 1: Build API v2 (NestJS + platform packages)
# =============================================================================
FROM node:20 AS api-builder

ARG DATABASE_URL="postgresql://placeholder:placeholder@placeholder:5432/placeholder"
ARG DATABASE_DIRECT_URL="postgresql://placeholder:placeholder@placeholder:5432/placeholder"

WORKDIR /calcom

# NODE_ENV must NOT be "production" during install — that would skip devDependencies
# (including typescript, which is needed to build the platform packages)
ENV NODE_ENV=development
ENV NODE_OPTIONS="--max-old-space-size=6144"
ENV DATABASE_URL=${DATABASE_URL}
ENV DATABASE_DIRECT_URL=${DATABASE_DIRECT_URL}
ENV USE_POOL=true

# Copy only what's needed for the API build
COPY package.json yarn.lock .yarnrc.yml turbo.json i18n.json ./
COPY .yarn ./.yarn
COPY apps/api/v2 ./apps/api/v2
COPY packages ./packages

# Install all deps (including devDependencies needed for build)
RUN yarn install --no-immutable

# Build platform deps + API using build:docker (which uses "yarn workspace X build"
# so it finds tsc via node_modules/.bin through yarn's script runner)
RUN yarn workspace @calcom/api-v2 run build:docker
RUN yarn workspace @calcom/api-v2 run build

# =============================================================================
# Stage 2: Add API to the official Cal.com web app image
# =============================================================================
FROM calcom/cal.com:latest

# Install procps for process management
RUN apt-get update && apt-get install -y --no-install-recommends \
    procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /calcom

# Copy compiled API artifacts from builder
COPY --from=api-builder /calcom/apps/api/v2/dist ./apps/api/v2/dist

# Copy platform package dist folders (referenced by API at runtime)
COPY --from=api-builder /calcom/packages/platform/constants/dist ./packages/platform/constants/dist
COPY --from=api-builder /calcom/packages/platform/enums/dist ./packages/platform/enums/dist
COPY --from=api-builder /calcom/packages/platform/utils/dist ./packages/platform/utils/dist
COPY --from=api-builder /calcom/packages/platform/types/dist ./packages/platform/types/dist
COPY --from=api-builder /calcom/packages/platform/libraries/dist ./packages/platform/libraries/dist

# Copy full node_modules from builder — the base image has web-only deps,
# we need NestJS and API-specific packages merged in
COPY --from=api-builder /calcom/node_modules ./node_modules

# Copy the prisma client (generated by API builder, may differ from web)
COPY --from=api-builder /calcom/packages/prisma/generated ./packages/prisma/generated

COPY scripts/start-cofoundy.sh ./scripts/start-cofoundy.sh
RUN chmod +x ./scripts/start-cofoundy.sh

EXPOSE 3000
EXPOSE 5555

CMD ["/calcom/scripts/start-cofoundy.sh"]
